# ==============================
# Server-only configuration
# NEVER prefix server secrets with VITE_.
# ==============================

# PostgreSQL connection used by the server/runtime.
DATABASE_URL=
POSTGRES_URL=

# Supabase server credentials. Never expose either value to browser code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Optional server-side AI integration.
GEMINI_API_KEY=

# Canonical public origin of the deployed app, e.g. https://example.com
APP_URL=

# ==============================
# Browser-safe Supabase config
# VITE_ values are embedded into the client bundle and are public by design.
# ==============================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
